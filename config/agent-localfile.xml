<!--
  Appended to C:\Program Files (x86)\ossec-agent\ossec.conf on WIN11-LAB.
  Wazuh reads Application, Security and System by default; these add
  Sysmon and PowerShell telemetry. Restart the agent after adding:
    NET STOP Wazuh
    NET START Wazuh
-->
<ossec_config>
  <localfile>
    <location>Microsoft-Windows-Sysmon/Operational</location>
    <log_format>eventchannel</log_format>
  </localfile>
  <localfile>
    <location>Microsoft-Windows-PowerShell/Operational</location>
    <log_format>eventchannel</log_format>
  </localfile>
</ossec_config>
